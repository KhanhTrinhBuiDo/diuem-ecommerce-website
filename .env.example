# Sao chép file này thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

# URL của website (dùng cho metadata/SEO). Trên Vercel: đặt theo domain production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (PLACEHOLDER: chưa dùng ở giai đoạn Header/Footer) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chỉ dùng ở server, tuyệt đối không đưa ra trình duyệt / không đặt tiền tố NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin (đường dẫn bí mật) ---
# Chuỗi ngẫu nhiên 16–64 ký tự a-z, 0-9, dấu gạch; admin sẽ ở /<slug>. KHÔNG dùng NEXT_PUBLIC_.
# Tạo: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_PATH_SLUG=
# Tạm thời (chưa có đăng nhập thật): đặt 1 để mở admin trên production. Bỏ biến này khi đã có auth + role.
ADMIN_PREVIEW=
