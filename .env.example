# Sao chép file này thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

# URL của website (dùng cho metadata/SEO). Trên Vercel: đặt theo domain production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API). Hai giá trị NEXT_PUBLIC là công khai, an toàn khi có RLS ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# KHÔNG đặt SUPABASE_SERVICE_ROLE_KEY trên Vercel / trong app. Chỉ dùng cục bộ khi chạy: node scripts/seed-admins.mjs (xem docs/HUONG_DAN_SUPABASE_VERCEL.md)

# --- Admin (đường dẫn bí mật) ---
# Chuỗi ngẫu nhiên 16–64 ký tự a-z, 0-9, dấu gạch; admin sẽ ở /<slug>. KHÔNG dùng NEXT_PUBLIC_.
# Tạo: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_PATH_SLUG=
